# ==============================================================================
# SaaS LLM Gateway - Environment Configuration
# Puerto: 8003
# ==============================================================================

SERVICE_NAME="llm-gateway"
APP_NAME="SaaS Core LLM Gateway & Ingestion Proxy"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8003
DEBUG=true

# Clave de servicio interno
INTERNAL_SERVICE_KEY="dev_internal_gateway_key_998877"

# Verificación de JWT de administrador
ADMIN_JWT_SECRET="dev_admin_jwt_secret_change_me_in_production_0002"

# Base de datos propia para Usage Ledger
DATABASE_URL="sqlite:///./data/ledger.db"

# Base de datos compartida de logs
LOGS_DATABASE_URL="sqlite:///../data/saas_logs.db"
ENABLE_AUDIT_DB=true

# Proveedor LLM (LM Studio en desarrollo, OpenAI en prod)
LLM_PROVIDER="lmstudio"
LLM_BASE_URL="http://localhost:1234/v1"
LLM_MODEL="local-model"
LLM_API_KEY="lm-studio"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
FALLBACK_SIMULATION_ON_LLM_ERROR=true

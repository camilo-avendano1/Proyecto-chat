# ==============================================================================
# Core SaaS Chat & Diagnostic Gateway - Environment Configuration
# Desarrollado por: Juan Camilo Avendaño, Fran Sneider Quincha, Adriana Moreno
# Clientes: SIGIRES (Procex Software S.A.S) y futuras entidades corporativas
# ==============================================================================

APP_NAME="Core SaaS Chat & Diagnostic Gateway (Back Central)"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=true

# ==============================================================================
# CONFIGURACIÓN DEL MODELO DE IA (LLM)
# ==============================================================================
# PERFIL 1: LM STUDIO (Local - Por defecto para pruebas locales)
# En LM Studio: Active el "Local Server" en el puerto 1234
LLM_PROVIDER="lmstudio"
LLM_BASE_URL="http://localhost:1234/v1"
LLM_MODEL="local-model"
LLM_API_KEY="lm-studio"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
FALLBACK_SIMULATION_ON_LLM_ERROR=true

# PERFIL 2: OLLAMA (Local - Alternativa)
# LLM_PROVIDER="ollama"
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="llama3"
# LLM_API_KEY="ollama"

# PERFIL 3: PRODUCCIÓN (OpenAI / DeepSeek / Azure)
# En producción simplemente reemplace con las credenciales reales:
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"
# LLM_API_KEY="sk-proj-tu-api-key-real-aqui"

# ==============================================================================
# ENRUTAMIENTO MULTI-CLIENTE A APIS DE BÚSQUEDA (BACK - BUSQUEDA)
# ==============================================================================
# Cada cliente/empresa puede tener su propia API de búsqueda
CLIENT_BUSQUEDA_URLS={"sigires": "http://localhost:8001", "default": "http://localhost:8001"}
BACK_BUSQUEDA_TIMEOUT_SECONDS=5.0
FALLBACK_LOCAL_SEARCH=true

# ==============================================================================
# SEGURIDAD Y TOKENS JWT
# ==============================================================================
JWT_SECRET_KEY="saas_core_secret_key_change_in_production_2026"
JWT_ALGORITHM="HS256"
SESSION_EXPIRES_SECONDS=1800
DEFAULT_WIDGET_API_KEY="pk_live_sigires_8f9a2b1c3d4e5f6a"

# ==============================================================================
# PRIVACIDAD Y HABEAS DATA (Ley 1581 de 2012)
# ==============================================================================
ENABLE_PII_SCRUBBING=true

# ==============================================================================
# CORS
# ==============================================================================
CORS_ORIGINS=["https://sigires.procex.co","http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ==============================================================================
# SaaS Auth Service - Environment Configuration
# Puerto: 8002
# ==============================================================================

SERVICE_NAME="auth-service"
APP_NAME="SaaS Auth Service (Usuarios Widget y Administradores)"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8002
DEBUG=true

# Base de datos propia (SQLite en dev, PostgreSQL en producción)
DATABASE_URL="sqlite:///./data/auth.db"

# Base de datos compartida de auditoría de logs
LOGS_DATABASE_URL="sqlite:///../data/saas_logs.db"
ENABLE_AUDIT_DB=true

# JWT Secrets (compartidos con los servicios que verifican)
WIDGET_JWT_SECRET="dev_widget_jwt_secret_change_me_in_production_0001"
ADMIN_JWT_SECRET="dev_admin_jwt_secret_change_me_in_production_0002"
JWT_ALGORITHM="HS256"
SESSION_EXPIRES_SECONDS=1800
ADMIN_TOKEN_EXPIRES_SECONDS=3600

# Bootstrap Superadmin (si no existe ningún admin en la DB)
BOOTSTRAP_ADMIN_USERNAME="superadmin"
BOOTSTRAP_ADMIN_PASSWORD="AdminPassword2026!"

# Seguridad de Administradores
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# Semilla de datos de demostración
SEED_DEMO_DATA=true
DEFAULT_WIDGET_API_KEY="pk_live_sigires_8f9a2b1c3d4e5f6a"
